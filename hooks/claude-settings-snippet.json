{
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "$HOME/.edge-odyssey/hooks/edge-odyssey-hook.sh working", "timeout": 5 }] }],
    "PreToolUse":       [{ "hooks": [{ "type": "command", "command": "$HOME/.edge-odyssey/hooks/edge-odyssey-hook.sh working", "timeout": 5 }] }],
    "PostToolUse":      [{ "hooks": [{ "type": "command", "command": "$HOME/.edge-odyssey/hooks/edge-odyssey-hook.sh working", "timeout": 5 }] }],
    "Notification": [{
      "matcher": "permission_prompt|idle_prompt|elicitation_dialog|agent_needs_input",
      "hooks": [{ "type": "command", "command": "$HOME/.edge-odyssey/hooks/edge-odyssey-hook.sh waiting", "timeout": 5 }]
    }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "$HOME/.edge-odyssey/hooks/edge-odyssey-hook.sh waiting", "timeout": 5 }] }],
    "StopFailure":      [{ "matcher": "rate_limit", "hooks": [{ "type": "command", "command": "$HOME/.edge-odyssey/hooks/edge-odyssey-hook.sh limit", "timeout": 5 }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "$HOME/.edge-odyssey/hooks/edge-odyssey-hook.sh end", "timeout": 5 }] }]
  },
  "statusLine": { "type": "command", "command": "$HOME/.edge-odyssey/hooks/edge-odyssey-statusline.sh" }
}
